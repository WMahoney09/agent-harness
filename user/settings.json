{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Skill(*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(npm view *)",
      "Bash(npm install *)",
      "Bash(node ace *)",
      "Read(~/.claude/skills/**)",
      "Read(~/.claude/projects/*/memory/**)",
      "Edit(~/.claude/projects/*/memory/**)",
      "Bash(mkdir -p ~/.claude/projects/*/memory)",
      "Read(~/agentic/tooling/**)",
      "Edit(~/agentic/tooling/**)",
      "Read(//tmp/**)",
      "Edit(//tmp/**)",
      "Read(//private/tmp/**)",
      "Edit(//private/tmp/**)",
      "Read(//dev/null)",
      "WebSearch",
      "mcp__render__get_deploy",
      "mcp__render__list_deploys",
      "mcp__render__list_logs",
      "mcp__figma__use_figma",
      "mcp__claude_ai_Circleback__SearchMeetings",
      "mcp__claude_ai_Circleback__GetTranscriptsForMeetings",
      "Bash(git:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-pr-review-state.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/gnar-statusline.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/gnar-subagent-statusline.sh"
  },
  "enabledPlugins": {
    "ideate@gnar": true,
    "ignite@gnar": true,
    "gnar-react@gnar": true,
    "spacebase@gnar": true,
    "audit@gnar": true,
    "toolkit@gnar": true,
    "gninety@gnar": true
  },
  "extraKnownMarketplaces": {
    "gnar": {
      "source": {
        "source": "github",
        "repo": "TheGnarCo/agent-skills"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true
}
